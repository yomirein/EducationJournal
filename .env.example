DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/learning
SECRET_KEY=replace-with-a-long-random-secret-before-use
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE=30
REFRESH_TOKEN_EXPIRE=10080
UPLOAD_DIR=uploads
# FIRST_ADMIN_USERNAME=admin
# FIRST_ADMIN_EMAIL=admin@example.com
# FIRST_ADMIN_PASSWORD=replace-with-a-unique-long-password
# FIRST_ADMIN_FIRST_NAME=Admin
# FIRST_ADMIN_LAST_NAME=Admin

# --- Почта (SMTP) ---
# Вариант А: локальная проверка через Mailpit (docker compose up -d mailpit).
# Письма никуда не уходят, их видно на http://127.0.0.1:8025.
# Если API запущен в Docker (docker compose up), укажите MAIL_SERVER=mailpit.
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@pixelstart.dev
MAIL_SSL_TLS=False
MAIL_STARTTLS=False

# Вариант Б: настоящая отправка через Яндекс Почту. Закомментируйте вариант А и раскомментируйте:
# MAIL_SERVER=smtp.yandex.ru
# MAIL_PORT=465
# MAIL_SSL_TLS=True
# MAIL_STARTTLS=False
# MAIL_USERNAME=youremail@yandex.ru
# MAIL_PASSWORD=app-password-from-id.yandex.ru
# MAIL_FROM=youremail@yandex.ru

